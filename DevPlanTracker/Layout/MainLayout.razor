@using System.Reflection
@inherits LayoutComponentBase

<div style="display: flex; flex-direction: column; min-height: 100vh;">
    <main style="flex: 1; padding: 20px;">
        @Body
    </main>

    <footer style="text-align: center; color: #7f8c8d; font-size: 0.85em; padding: 20px 0; border-top: 1px solid #e2e8f0;">
        DevPlanTracker v@(AppVersion)
    </footer>
</div>

@code {
    private string AppVersion => Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "1.0.0";
}